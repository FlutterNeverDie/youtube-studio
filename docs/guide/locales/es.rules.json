{
 "_설명": "스페인어 대사 규칙 (es.md를 기계가 잡을 수 있게, 중남미 중립·tú). scripts/check-text.py가 씀, 편집기에 오류로 뜸. 고치면 python3 scripts/check-text.py --selftest",
 "lang": "es",
 "registers": {
  "_설명": "인물 대사의 2인칭 - 한 인물이 tú와 usted를 섞지 않는지(장면 사이). 내레이션은 tú(시청자 여럿에겐 ustedes 괜찮음)",
  "narration": "tú",
  "speaker_level": "warn",
  "classes": {
   "usted": {"pattern": "\\busted\\b|\\b(?:sabe usted|oiga|mire|fíjese|dígame|escuche|venga acá)\\b", "flags": "i", "examples": ["Oiga, ¿qué hace usted aquí?", "Mire, señor."]},
   "tú": {"pattern": "\\b(?:tú|contigo|eres|tienes|puedes|sabes|quieres|vienes|estás|haces|dices|vas|oye|dime|fíjate|mira)\\b", "flags": "i", "examples": ["Oye, ¿tú qué sabes?", "Eres un traidor."]}
  }
 },
 "rules": [
  {
   "id": "es-spain", "group": "스페인 표현", "kind": "style", "level": "error", "scope": "all", "position": "anywhere",
   "pattern": "\\b(?:vosotros|vosotras|os|habéis|sois|tenéis|estáis|ordenador)\\b", "flags": "i",
   "msg": "스페인 전용 표현 - 채널은 중남미 중립 (vosotros → ustedes)",
   "bad": ["Os voy a contar algo.", "¿Sabéis qué pasó? Vosotros no."], "good": ["Les voy a contar algo.", "¿Saben qué pasó?"]
  },
  {
   "id": "es-vosotros-verb", "group": "스페인 표현", "kind": "style", "level": "error", "scope": "all", "position": "anywhere",
   "pattern": "\\b\\w+[áé]is\\b", "flags": "i",
   "msg": "vosotros 동사 꼴(-áis/-éis) - ustedes 꼴로",
   "bad": ["¿Podéis imaginarlo?", "Ya lo sabéis."], "good": ["¿Pueden imaginarlo?", "Eran seis jinetes."]
  },
  {
   "id": "es-coger", "group": "스페인 표현", "kind": "style", "level": "error", "scope": "all", "position": "anywhere",
   "pattern": "\\b(?:coger|coge|coges|cogen|cogió|cogieron|cogía|cogían|cogiendo|cogido|cogida|cogidos|cogidas|cojo|coja|cojan|cojas)\\b", "flags": "i",
   "msg": "\"coger\"는 중남미에서 비속어 - tomar·agarrar·capturar",
   "bad": ["Cogió la espada.", "Lo cogieron vivo."], "good": ["Tomó la espada.", "Tuvo que escoger un camino.", "Fueron a recoger el botín."]
  },
  {
   "id": "es-vale", "group": "스페인 표현", "kind": "style", "level": "error", "scope": "all", "position": "anywhere",
   "pattern": "\\bvale\\b(?=\\s*[,.!?…]|\\s*$)", "flags": "i",
   "except": ["vale la pena", "no vale", "(?:más|menos|lo que|cuánto) vale", "vale (?:más|menos|mucho|poco|nada)"],
   "msg": "맞장구 \"vale\"는 스페인 말투 - \"bueno\"·\"está bien\"",
   "suggest": ["bueno"],
   "bad": ["Vale, vamos al grano.", "¿Vale?"], "good": ["Vale la pena recordarlo.", "Eso no vale.", "Su oro vale mucho.", "¿Cuánto vale?"]
  },
  {
   "id": "es-usted", "group": "tú/usted", "kind": "style", "level": "error", "scope": "narration", "position": "anywhere",
   "pattern": "\\busted\\b", "flags": "i",
   "msg": "내레이션은 시청자에게 tú (여럿에겐 ustedes) - usted 섞지 않기",
   "bad": ["Como usted ya sabe, el kan murió."], "good": ["Como ya sabes, el kan murió.", "Ustedes ya lo saben."]
  },
  {
   "id": "es-usted-imperative", "group": "tú/usted", "kind": "style", "level": "error", "scope": "narration", "position": "anywhere",
   "pattern": "(?:^|(?<=[.!?…]\\s)|(?<=[¡¿]))(?:Mire|Fíjese|Imagínese|Imagine|Escuche|Piense|Recuerde|Sepa|Dígame|Oiga)\\b",
   "map": {"Mire": "Mira", "Fíjese": "Fíjate", "Imagínese": "Imagínate", "Imagine": "Imagina", "Escuche": "Escucha", "Piense": "Piensa", "Recuerde": "Recuerda", "Sepa": "Debes saber", "Dígame": "Dime", "Oiga": "Oye"},
   "msg": "usted 명령꼴 - 내레이션은 tú (Mire → Mira)",
   "bad": ["Imagine esto: un imperio sin fin.", "¡Mire el mapa!"], "good": ["Imagina esto: un imperio sin fin.", "Nadie quería que el kan piense así."],
   "fixes": [["¡Mire el mapa!", "¡Mira el mapa!"]]
  },
  {
   "id": "es-anglicismo", "group": "영어 직역", "kind": "style", "level": "warn", "scope": "all", "position": "anywhere",
   "pattern": "\\b(?:hace sentido|hacía sentido|hizo sentido|hacer sentido|en orden de|aplicar para|aplicó para|toma lugar|tomó lugar|tomar lugar|jugar un rol|jugó un rol|juega un rol)\\b", "flags": "i",
   "map": {"hace sentido": "tiene sentido", "hacía sentido": "tenía sentido", "hizo sentido": "tuvo sentido", "hacer sentido": "tener sentido", "en orden de": "para", "aplicar para": "postularse a", "aplicó para": "se postuló a", "toma lugar": "tiene lugar", "tomó lugar": "tuvo lugar", "tomar lugar": "tener lugar", "jugar un rol": "tener un papel", "jugó un rol": "tuvo un papel", "juega un rol": "tiene un papel"},
   "msg": "영어 직역(anglicismo) - 스페인어 관용 표현으로",
   "bad": ["Eso no hace sentido.", "La batalla tomó lugar en 1223."], "good": ["Eso no tiene sentido.", "La batalla tuvo lugar en 1223."],
   "fixes": [["Eso no hace sentido.", "Eso no tiene sentido."]]
  },
  {
   "id": "es-passive", "group": "영어 직역", "kind": "style", "level": "warn", "scope": "all", "position": "anywhere", "overuse": 4,
   "pattern": "\\b(?:fue|fueron)\\s+(?:\\w+mente\\s+|muy\\s+|casi\\s+)?\\w+(?:ado|ada|ados|adas|ido|ida|idos|idas)\\b", "flags": "i",
   "msg": "수동태(fue + 과거분사)가 편에 많음 - 능동태나 se 구문으로",
   "bad": ["La ciudad fue destruida."], "good": ["Los mongoles destruyeron la ciudad.", "Fue a Kiev."]
  },
  {
   "id": "es-thousands", "group": "숫자", "kind": "style", "level": "warn", "scope": "all", "position": "anywhere",
   "pattern": "(?<![\\d.,])\\d{1,3}(?:,\\d{3})+(?![\\d,])|(?<![\\d.,])\\d{5,}(?![\\d.,])",
   "fix": "es_thousands",
   "msg": "천 단위는 마침표 (20.000 jinetes)",
   "bad": ["Llegaron 20,000 jinetes.", "Eran 100000 hombres."], "good": ["Llegaron 20.000 jinetes.", "En 1223."],
   "fixes": [["Llegaron 20,000 jinetes.", "Llegaron 20.000 jinetes."], ["Eran 100000 hombres.", "Eran 100.000 hombres."]]
  },
  {
   "id": "es-siglo", "group": "숫자", "kind": "style", "level": "warn", "scope": "all", "position": "anywhere",
   "pattern": "\\bsiglo\\s+(\\d{1,2})\\b", "flags": "i",
   "fix": "roman",
   "msg": "세기는 로마 숫자 (siglo XIII)",
   "bad": ["En el siglo 13."], "good": ["En el siglo XIII."],
   "fixes": [["En el siglo 13.", "En el siglo XIII."]]
  },
  {
   "id": "es-pairs", "group": "문장부호", "kind": "style", "level": "error", "scope": "all",
   "check": "es_pairs",
   "msg": "물음표·느낌표는 여는 부호 ¿ ¡ 짝이 필수",
   "bad": ["Qué pasó?", "¡Al ataque", "Increíble!"], "good": ["¿Qué pasó?", "¡Al ataque!", "¿Y saben qué pasó? Nadie volvió."]
  },
  {
   "id": "es-english-left", "group": "영어 직역", "kind": "style", "level": "warn", "scope": "all", "position": "anywhere",
   "pattern": "\\b(?:the|and|of|with|but|this|that|was|were|they|their)\\b", "flags": "i",
   "msg": "번역 안 하고 남은 영어 낱말",
   "bad": ["El kan and sus hijos."], "good": ["El kan y sus hijos."]
  },
  {
   "id": "es-paren", "group": "발음", "kind": "pron", "level": "warn", "scope": "all", "position": "anywhere",
   "pattern": "[()\\[\\]]|[~/&*#@]",
   "msg": "괄호·기호는 TTS가 읽거나 이상하게 끊음 - 말로 풀어 쓰기",
   "bad": ["Temuyín (Gengis Kan) llegó."], "good": ["Temuyín, el futuro Gengis Kan, llegó."]
  },
  {
   "id": "es-abbr", "group": "발음", "kind": "pron", "level": "warn", "scope": "all", "position": "anywhere",
   "pattern": "\\b(?:a\\.\\s?C\\.|d\\.\\s?C\\.|aprox\\.|etc\\.|Sr\\.|Sra\\.|núm\\.|vs\\.|aC|dC)",
   "msg": "줄임말 - TTS가 철자로 읽을 수 있음, 풀어 쓰기 (antes de Cristo)",
   "bad": ["En el 500 a. C. no existía."], "good": ["En el año 500 antes de Cristo."]
  },
  {
   "id": "es-roman", "group": "발음", "kind": "pron", "level": "warn", "scope": "all", "position": "anywhere",
   "pattern": "(?<!siglo )\\b[IVXL]{2,}\\b",
   "msg": "로마 숫자(세기 말고) - TTS 읽기 확인, 필요하면 audio/pron.json (Mohamed II → Mohamed segundo)",
   "bad": ["Mstislav III huyó."], "good": ["En el siglo XIII.", "Mohamed II huyó."]
  },
  {
   "id": "es-caps", "group": "발음", "kind": "pron", "level": "warn", "scope": "all", "position": "anywhere",
   "pattern": "\\b(?![IVXL]+\\b)[A-ZÁÉÍÓÚÑ]{2,}\\b",
   "msg": "대문자 줄임말 - TTS가 철자로 읽음",
   "bad": ["La ONU no existía."], "good": ["Las Naciones Unidas no existían."]
  },
  {
   "id": "es-ai-phrase", "group": "AI 티", "kind": "style", "level": "warn", "scope": "all", "position": "anywhere",
   "pattern": "\\b(?:cabe (?:destacar|mencionar|señalar|resaltar|recordar)|es importante (?:destacar|mencionar|señalar|resaltar|recordar|notar)|vale la pena (?:destacar|mencionar|señalar|resaltar)|sin lugar a dudas?|sin duda alguna|(?:es|fue|era|son|fueron|eran) (?:un |el )?(?:verdadero |claro |vivo )?testimonio de|(?:el|un|este|ese) (?:rico |vasto |complejo )?tapiz de|adentrémonos|sumerjámonos|embarquémonos|un viaje fascinante|(?:dejó|dejaron|deja|dejan) una huella imborrable|(?:marcó|marcaron|marca) un antes y un después|(?:desempeñó|desempeñaron|desempeña|jugó|jugaron|juega) un papel (?:crucial|fundamental|clave|vital|esencial)|en el vasto (?:mundo|panorama|universo)|en conclusión)\\b", "flags": "i",
   "map": {"sin lugar a dudas": "sin duda", "sin lugar a duda": "sin duda", "sin duda alguna": "sin duda"},
   "msg": "AI 글 상투구 (cabe destacar · un testimonio de · sin lugar a dudas · un papel crucial) - 유튜버는 이렇게 말 안 함. 빼고 사실을 바로 말하기",
   "bad": ["Cabe destacar que los mongoles no tenían flota.", "La muralla es un testimonio de su poder.", "Sin lugar a dudas, fue la mayor conquista.", "Jebe jugó un papel crucial."], "good": ["Los mongoles no tenían flota.", "Juvaini dejó un testimonio de la caída de Bujará.", "Sin duda, fue la mayor conquista.", "Vale la pena recordarlo."],
   "fixes": [["Sin lugar a dudas, fue la mayor conquista.", "Sin duda, fue la mayor conquista."]]
  },
  {
   "id": "es-hedge-stack", "group": "AI 티", "kind": "style", "level": "warn", "scope": "all", "position": "anywhere",
   "pattern": "\\b(?:aproximadamente|alrededor de|cerca de|casi|más o menos|unos|unas|poco más de|algo más de)\\s+(?:aproximadamente|alrededor de|cerca de|unos|unas|más o menos|casi)(?=\\s+(?:\\d|un\\b|una\\b|dos|tres|cuatro|cinco|seis|siete|ocho|nueve|diez|once|doce|quince|veinte|treinta|cuarenta|cincuenta|sesenta|setenta|ochenta|noventa|cien|mil\\b|doscient|trescient|cuatrocient|quinient|seiscient|setecient|ochocient|novecient))|\\b(?:unos|unas|alrededor de|cerca de|casi)\\s+[\\d.]+(?:\\s+\\w+){0,2}\\s+(?:aproximadamente|más o menos)\\b", "flags": "i",
   "msg": "어림말 겹침 (alrededor de unos · unos 150.000 ... aproximadamente) - 영어 about을 매번 옮긴 것. 숫자는 한 번만 어림 (unos 20.000)",
   "bad": ["Llegaron alrededor de unos 20.000 jinetes.", "Eran unos 150.000 soldados aproximadamente.", "Había casi unos mil hombres."], "good": ["Llegaron unos 20.000 jinetes.", "Acamparon cerca de unos pozos.", "Eran casi 150.000 soldados.", "Apenas unos días después, cayó."]
  },
  {
   "id": "es-written", "group": "문어체", "kind": "style", "level": "warn", "scope": "all", "position": "anywhere",
   "pattern": "\\b(?:asimismo|no obstante|posteriormente|por consiguiente|mediante|a fin de|con el fin de|aproximadamente|(?:el|la|los|las) cual(?:es)?|cuy[oa]s?|(?:en|de|a|por|con|para|desde|hacia|sobre|tras|ante) dich[oa]s?(?=\\s+\\w)|restantes)\\b", "flags": "i",
   "map": {"asimismo": "también", "no obstante": "pero", "posteriormente": "después", "por consiguiente": "así que", "mediante": "con", "a fin de": "para", "con el fin de": "para", "aproximadamente": "unos", "restantes": "que quedaban"},
   "msg": "글말(문어체) - 내레이션은 말로 (no obstante → pero, posteriormente → después, mediante → con, los soldados restantes → los soldados que quedaban, aproximadamente → unos)",
   "bad": ["No obstante, la ciudad resistió.", "Los soldados restantes se refugiaron allí.", "Cruzaron el río mediante balsas.", "Llegaron a Otrar, cuyas murallas eran altas.", "En dicha ciudad no quedó nadie."], "good": ["Pero la ciudad resistió.", "Los soldados que quedaban se refugiaron allí.", "Cruzaron el río en balsas.", "Gengis lo había dicho antes.", "Lo cual nadie esperaba."],
   "fixes": [["Posteriormente volvieron al norte.", "Después volvieron al norte."], ["Tenía aproximadamente 150.000 soldados.", "Tenía unos 150.000 soldados."]]
  },
  {
   "id": "es-step-enum", "group": "영어 직역", "kind": "style", "level": "warn", "scope": "all", "position": "anywhere",
   "pattern": "(?:^|(?<=[.!?…:]\\s)|(?<=/\\s))(?:Paso (?:uno|dos|tres|cuatro|cinco|[1-5])\\b|(?:Uno|Una|Dos|Tres|Cuatro|Cinco)(?=\\s*:))",
   "map": {"Paso uno": "Primer paso", "Paso 1": "Primer paso", "Paso dos": "Segundo paso", "Paso 2": "Segundo paso", "Paso tres": "Tercer paso", "Paso 3": "Tercer paso", "Paso cuatro": "Cuarto paso", "Paso 4": "Cuarto paso", "Paso cinco": "Quinto paso", "Paso 5": "Quinto paso", "Una": "La primera", "Uno": "Primero"},
   "msg": "영어식 번호 매기기 (Step one: · One: · Two:) - 스페인어 말로는 서수 (Primer paso: · La primera: · Primero, ... Después, ...)",
   "bad": ["Paso uno: conseguir un guía.", "Y les dio dos razones. Una: los Jin habían apoyado a los tártaros."], "good": ["Primer paso: conseguir un guía.", "La primera: los Jin habían apoyado a los tártaros.", "Uno de ellos huyó.", "Dos días después, cayó."],
   "fixes": [["Paso uno: conseguir un guía.", "Primer paso: conseguir un guía."]]
  },
  {
   "id": "es-calco", "group": "영어 직역", "kind": "style", "level": "warn", "scope": "all", "position": "anywhere",
   "pattern": "\\b(?:(?:ya )?(?:tenían|tienen) historia(?! de)|eventualmente|realiz(?:ó|aron|a|an) que|(?:tomar|tomó|tomaron|toma|toman) ventaja de|(?:es|era) tiempo de(?= \\w+(?:ar|er|ir)\\b)|(?:hacer|hizo|hace|hacen|hicieron) la diferencia)\\b", "flags": "i",
   "map": {"tenían historia": "tenían cuentas pendientes", "ya tenían historia": "ya tenían cuentas pendientes", "tienen historia": "tienen cuentas pendientes", "ya tienen historia": "ya tienen cuentas pendientes", "eventualmente": "al final", "realizó que": "se dio cuenta de que", "realizaron que": "se dieron cuenta de que", "realiza que": "se da cuenta de que", "realizan que": "se dan cuenta de que", "tomar ventaja de": "aprovechar", "tomó ventaja de": "aprovechó", "tomaron ventaja de": "aprovecharon", "toma ventaja de": "aprovecha", "toman ventaja de": "aprovechan", "es tiempo de": "es hora de", "era tiempo de": "era hora de", "hacer la diferencia": "marcar la diferencia", "hizo la diferencia": "marcó la diferencia", "hace la diferencia": "marca la diferencia", "hacen la diferencia": "marcan la diferencia", "hicieron la diferencia": "marcaron la diferencia"},
   "msg": "영어 낱말을 그대로 옮긴 직역(calco) - eventually → al final, realize → darse cuenta, take advantage → aprovechar, had history → tenían cuentas pendientes",
   "bad": ["Eventualmente, la ciudad cayó.", "Gengis realizó que lo engañaban.", "Es que estos dos tenían historia.", "Tomaron ventaja de la noche.", "Era tiempo de atacar."], "good": ["Al final, la ciudad cayó.", "Gengis se dio cuenta de que lo engañaban.", "Es que estos dos tenían cuentas pendientes.", "Aprovecharon la noche.", "Realizó un ataque.", "Era tiempo de cosecha.", "Las dos ciudades tenían historia de siglos."],
   "fixes": [["Eventualmente, la ciudad cayó.", "Al final, la ciudad cayó."], ["Tomaron ventaja de la noche.", "Aprovecharon la noche."]]
  },
  {
   "id": "es-grueso", "group": "영어 직역", "kind": "style", "level": "warn", "scope": "all", "position": "anywhere",
   "pattern": "\\b(?:la|su) fuerza principal(?: mongola)?\\b", "flags": "i",
   "map": {"la fuerza principal": "el grueso del ejército", "su fuerza principal": "el grueso de su ejército", "la fuerza principal mongola": "el grueso del ejército mongol"},
   "msg": "'main force' 직역 - 스페인어 군사 관용은 el grueso (del ejército)",
   "bad": ["Su fuerza principal fue a la frontera.", "La fuerza principal mongola se reagrupó."], "good": ["El grueso de su ejército fue a la frontera.", "Su fuerza era la caballería."],
   "fixes": [["La fuerza principal mongola se reagrupó.", "El grueso del ejército mongol se reagrupó."]]
  },
  {
   "id": "es-extra", "group": "영어 직역", "kind": "style", "level": "warn", "scope": "all", "position": "anywhere",
   "pattern": "\\b(caballos|monturas|hombres|soldados|flechas|armas|raciones|provisiones)\\s+extras?\\b", "flags": "i",
   "suggest": ["\\1 de repuesto"],
   "msg": "'extra horses' 직역 - de repuesto (말은 caballos de refresco도 관용)",
   "bad": ["Cada soldado llevaba varios caballos extra."], "good": ["Cada soldado llevaba varios caballos de repuesto.", "Trabajaron horas extra."],
   "fixes": [["Cada soldado llevaba varios caballos extra.", "Cada soldado llevaba varios caballos de repuesto."]]
  },
  {
   "id": "es-passive-por", "group": "영어 직역", "kind": "style", "level": "warn", "scope": "all", "position": "anywhere",
   "pattern": "\\b(?:es|son|era|eran|fue|fueron|será|serán|sería|serían|sido)\\s+(?:\\w+mente\\s+|muy\\s+|casi\\s+)?(?!(?:nada|cada|vida|ida|salida|comida|medida|partida|herida|bebida|llegada|entrada|mirada|jornada|armada|espada|morada|cruzada|emboscada|nado|lado|grado|estado|soldado|pasado|mercado|ganado|legado|reinado|enviado|aliado|cuñado|prado|senado|conocido|conocida|conocidos|conocidas|reconocido|reconocida)\\b)\\w+(?:ado|ada|ados|adas|ido|ida|idos|idas)\\s+por\\b", "flags": "i",
   "msg": "ser + 과거분사 + por (영어 'was taken by') - 말로는 능동 (Los mongoles tomaron la ciudad) 또는 se 구문",
   "bad": ["Bujará fue rodeada por los mongoles.", "El sah había sido traicionado por sus generales."], "good": ["Los mongoles rodearon Bujará.", "Era conocido por su crueldad.", "Fue a Kiev por el río.", "Un hombre enviado por los Jin llegó."]
  },
  {
   "id": "es-gerund-chain", "group": "영어 직역", "kind": "style", "level": "warn", "scope": "all", "position": "anywhere",
