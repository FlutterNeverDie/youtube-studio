 "rules": [
  {
   "id": "enko-lasts-to",
   "src": "\\b(last|lasts|lasted|lasting|go|goes|went|going|run|runs)\\b[^.?!]*\\b(up to|to)\\b",
   "tgt": "까지 (갑니다|가요|간다|가는|갑니)",
   "msg": "\"lasts from A to B / goes up to\" 직역 - 시간 · 기간에 \"~까지 갑니다\"는 번역투",
   "natural": "짧으면 A, 길면 B쯤 이어집니다 / B까지 이어지기도 합니다",
   "bad": [
    [
     "A cramp lasts from a few seconds to ten minutes.",
     "쥐는 몇 초에서 10분까지 갑니다."
    ]
   ],
   "good": [
